<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RcrcGreen.Core.Tests</RootNamespace>
    <AssemblyName>RcrcGreen.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Core carries no Revit reference, so these run anywhere, including on the build
         machine that has no Revit on it. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RcrcGreen.Core\RcrcGreen.Core.csproj" />
  </ItemGroup>

</Project>

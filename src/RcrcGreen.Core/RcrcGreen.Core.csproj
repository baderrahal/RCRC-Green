<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RcrcGreen.Core</RootNamespace>
    <AssemblyName>RcrcGreen.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- netstandard2.0 otherwise falls back to C# 7.3 while the test project that consumes
         this gets C# 14, so the same line compiles there and fails here. That 14 is the SDK's
         own default for net10.0 and the test project declares no LangVersion, so it moves when
         the target does. -->
    <LangVersion>12.0</LangVersion>
    <!-- Core is consumed by a net48 add-in and by net10.0 tests, so it stays on the
         shared surface both can load. Nothing here may reference the Revit API. -->
  </PropertyGroup>

</Project>

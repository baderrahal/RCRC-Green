<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RcrcGreen.Revit</RootNamespace>
    <AssemblyName>RcrcGreen.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Revit 2024 runs on .NET Framework 4.8. Changing this target breaks the load. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RcrcGreen.Core\RcrcGreen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both ship with .NET Framework 4.8, so this adds no package and nothing to install.
         They are here for the progress window, which is the only way a user can see how far
         a long read has got and stop it. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- The dockable panel is WPF, which is what Revit hosts. The interface is built in C#
         rather than XAML, because an SDK style net48 project has no XAML compilation step and
         adding one is a build change nobody here can test. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Revit ships these assemblies itself. Copying them next to the add-in gives Revit two
         copies of the same types and it refuses to load, so the packages stay reference only. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="RcrcGreen.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The build stamp: the commit's short hash and the time this build ran, as the product
       version, with the word changed after it where the working copy holds uncommitted changes.
       The KPI pane header and its reports print it, and the team kit reads its version off it,
       so nobody types a version anywhere. A build where git cannot answer says no-commit. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="RcrcBuildStamp" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RcrcCommit" />
      <Output TaskParameter="ExitCode" PropertyName="RcrcCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RcrcChanges" />
    </Exec>
    <PropertyGroup>
      <RcrcCommit Condition="'$(RcrcCommitExit)' != '0' or '$(RcrcCommit)' == ''">no-commit</RcrcCommit>
      <RcrcBuilt>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</RcrcBuilt>
      <InformationalVersion>$(RcrcCommit) $(RcrcBuilt)</InformationalVersion>
      <InformationalVersion Condition="'$(RcrcChanges)' != ''">$(RcrcCommit) $(RcrcBuilt) changed</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>

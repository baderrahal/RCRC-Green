# Build output
bin/
obj/
dist/
build/
*.dll
*.pdb

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets. Never commit these.
.env
*.key
appsettings.local.json

# Editor
.vscode/settings.json
.idea/

# OS
Thumbs.db
.DS_Store

# Visual Studio and .NET
.vs/
*.user

# Test output
TestResults/

# Reports the add-in writes. This repository is public and a report holds client view names,
# sheet numbers, plot identifiers and schedule setups. Read them locally, commit none of them.
# The README stays, because it is the thing that says why.
reports/*
!reports/README.md

# No client workbook, template or filled output, ever. The GRP KPI Checklist files carry the
# Green Riyadh KPI targets, neighbourhood names and the full plant palette, and this
# repository is public. Tests build their own small workbooks in the temp folder instead.
*.xlsx
